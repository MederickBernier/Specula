# Copy to .env on the droplet and fill in. Never commit the filled-in copy.
#
# APP_KEY: generate once with `php artisan key:generate --show`. Changing it
# invalidates every session and every encrypted column, including 2FA secrets.

APP_NAME=Specula
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://specula.example.com

# The hostname Caddy answers on and requests a certificate for. Use "localhost"
# for a local smoke test to get a self-signed certificate instead.
APP_DOMAIN=specula.example.com
TLS_EMAIL=you@example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=specula
DB_USERNAME=specula
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies are HTTPS-only in production; Caddy terminates TLS in front.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
