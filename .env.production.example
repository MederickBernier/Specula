# Copy to .env on the droplet and fill in. Never commit the filled-in copy.
#
# APP_KEY: generate once with `php artisan key:generate --show`.
#
# READ THIS BEFORE DEPLOYING. The content of the work modules is encrypted in
# the database with this key: project, decision, vetting, prototype and security
# text is stored as ciphertext and is unreadable without it. That is the point,
# and it cuts both ways:
#
#   - Losing APP_KEY loses the data. A database backup is not a backup on its
#     own. Keep the key somewhere separate from the droplet and from the dumps,
#     because a copy of both together is the same as neither being encrypted.
#   - Changing APP_KEY does not re-encrypt anything. Everything already written
#     becomes unreadable. Rotating it means decrypting with the old key and
#     re-encrypting with the new one, in that order, while both are known.
#   - It also invalidates every session and every 2FA secret.

APP_NAME=Specula
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://specula.example.com

# The hostname Caddy answers on and requests a certificate for. Use "localhost"
# for a local smoke test to get a self-signed certificate instead.
APP_DOMAIN=specula.example.com
TLS_EMAIL=you@example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=specula
DB_USERNAME=specula
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies are HTTPS-only in production; Caddy terminates TLS in front.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
